# Frontend configuration
#
# In development the Vite dev server proxies /api to http://127.0.0.1:8000
# (see vite.config.ts), so this variable is only needed when the API lives
# somewhere else — for example a deployed backend, or a different local port.
#
# VITE_API_URL=http://127.0.0.1:8000/api/v1
