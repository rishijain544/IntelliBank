# ---------------------------------------------------------------------------
# IntelliBank backend configuration
# Copy to .env and adjust. Every value below is optional; the defaults run a
# zero-setup local demo on SQLite with an in-process rate limiter.
# ---------------------------------------------------------------------------

APP_NAME=IntelliBank
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# ---- Database -------------------------------------------------------------
# Default: SQLite file in the backend directory (no setup required).
# DATABASE_URL=sqlite:///./smartbank.db
#
# PostgreSQL (matches docker-compose.yml). Requires:
#   pip install "psycopg[binary]==3.2.10"
# DATABASE_URL=postgresql+psycopg://smartbank:smartbank@localhost:5432/smartbank
SQL_ECHO=false

# ---- Security -------------------------------------------------------------
# MUST be changed for any non-local deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
# 12 rounds ~250ms per hash. Do not lower for production convenience.
BCRYPT_ROUNDS=12
# Set true only when served over HTTPS (also enables HSTS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Redis (optional) -----------------------------------------------------
# When unset, rate limiting and token revocation use a thread-safe in-process
# store. That is correct for single-process dev; set this for multi-worker
# deployments, where an in-memory limiter would be per-worker and ineffective.
# REDIS_URL=redis://localhost:6379/0

# ---- Rate limits ("requests/seconds") -------------------------------------
RATE_LIMIT_LOGIN=8/300
RATE_LIMIT_REGISTER=5/3600
RATE_LIMIT_TRANSFER=20/60
RATE_LIMIT_DEFAULT=300/60

# ---- Banking rules --------------------------------------------------------
LARGE_TXN_NOTIFY_THRESHOLD=50000
DAILY_TRANSFER_LIMIT=500000
MIN_SAVINGS_BALANCE=500
CURRENT_ACCOUNT_OVERDRAFT=25000

# ---- ML decision thresholds ----------------------------------------------
# Model-learned thresholds live in the artifacts; these are the *policy* limits
# applied on top of the model score.
FRAUD_BLOCK_THRESHOLD=0.90
FRAUD_REVIEW_THRESHOLD=0.55
ANOMALY_ALERT_THRESHOLD=0.62

# ---- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
